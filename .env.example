# Copy to .env — tests/conftest.py loads it automatically.
#
# Nothing below is needed for `make test`: the default test run uses the local
# containers from `make services` and needs no API keys.

# --- live tests (`make test_live`) call these paid APIs
OPENAI_API_KEY=""
COHERE_API_KEY=""
AURELIO_API_KEY=""

# --- local services (defaults shown; match compose.yaml)
PINECONE_API_KEY="pclocal"
PINECONE_API_BASE_URL="http://localhost:5080"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="postgres"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
QDRANT_URL="http://localhost:6333"
